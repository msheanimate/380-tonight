# Copy this file to .env and fill in your own Supabase project's values.
# Find both under Project Settings > API in your Supabase dashboard.
# The publishable key (formerly called the "anon" key) is safe to expose in
# client-side code -- it only works within the row-level-security rules
# defined in supabase/schema.sql.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
