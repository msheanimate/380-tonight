---
/** /admin/ -- The 380's admin dashboard. Approve bar owners who ask to manage
 *  a venue, add or remove managers yourself, jump into any venue's portal, and
 *  keep an eye on (and remove) what venues post. Only accounts listed in
 *  public.site_admins get in -- see supabase/venue-portal.sql. */
import Base from '../layouts/Base.astro';
import { venues } from '../lib/data';

const venueIndex = venues.map((v: any) => ({ slug: v.slug, name: v.name, city: v.city }))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Admin" description="The 380 admin dashboard">
  <div class="ad" id="ad" data-venues={JSON.stringify(venueIndex)}>
    <p class="kicker">Admin</p>
    <h1>The 380 dashboard</h1>

    <div id="ad-state" class="card ad-note">Loading…</div>

    <div id="ad-app" hidden>
      <div class="ad-stats" id="ad-stats"></div>

      <section class="card ad-card">
        <div class="ad-head"><h2>Owner requests</h2><span class="ad-sub" id="ad-req-count"></span></div>
        <div id="ad-requests" class="ad-list"></div>
      </section>

      <section class="card ad-card">
        <div class="ad-head"><h2>Venue managers</h2></div>
        <div id="ad-managers" class="ad-list"></div>
        <form id="ad-add" class="ad-add">
          <p class="ad-label">Add a manager yourself</p>
          <div class="ad-add-row">
            <input id="ad-add-user" placeholder="Their username" autocomplete="off" required />
            <select id="ad-add-venue" required>
              <option value="">Venue…</option>
              {venueIndex.map((v) => <option value={v.slug}>{v.name} · {v.city}</option>)}
            </select>
            <button type="submit" class="btn">Add</button>
          </div>
          <p class="ad-msg" id="ad-add-msg" role="status"></p>
        </form>
      </section>

      <section class="card ad-card">
        <div class="ad-head"><h2>Edit any venue</h2></div>
        <p class="ad-help">As an admin you can open any venue's portal: feed, happy hours, menu, events and photos.</p>
        <div class="ad-add-row">
          <select id="ad-jump">
            <option value="">Choose a venue…</option>
            {venueIndex.map((v) => <option value={v.slug}>{v.name} · {v.city}</option>)}
          </select>
          <a class="btn" id="ad-jump-go" href="/manage/">Open portal</a>
        </div>
      </section>

      <section class="card ad-card">
        <div class="ad-head"><h2>Latest from venues</h2><span class="ad-sub">Posts and photos owners have added. Remove anything that shouldn't be up.</span></div>
        <div id="ad-activity" class="ad-activity"></div>
      </section>
    </div>
  </div>
</Base>

<script>
  import { supabase, supabaseConfigured } from '../lib/supabase';
  import { esc, timeAgo, fmtDate, removeVenueFile, todayCT } from '../lib/venue-portal';

  type Req = { id: number; user_id: string; venue_slug: string; status: string; note: string | null; created_at: string; decided_at: string | null; username: string | null; display_name: string | null; avatar_url: string | null; email: string | null };
  const root = document.getElementById('ad')!;
  const VENUES: { slug: string; name: string; city: string }[] = JSON.parse(root.dataset.venues || '[]');
  const vname = (s: string) => VENUES.find((v) => v.slug === s)?.name ?? s;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const state = $('ad-state');
  let rows: Req[] = [];

  async function init() {
    if (!supabaseConfigured || !supabase) { state.textContent = 'Accounts aren’t connected yet.'; return; }
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) { state.innerHTML = '<a href="/login/">Log in</a> with your admin account.'; return; }
    const adm = await supabase.rpc('is_admin');
    if (adm.error) {
      state.innerHTML = 'The admin tools aren’t switched on yet. Run <code>supabase/venue-portal.sql</code> in Supabase’s SQL Editor, then add yourself as an admin (the steps are at the top of that file).';
      return;
    }
    if (adm.data !== true) { state.textContent = 'This page is for The 380’s admins.'; return; }
    state.hidden = true;
    $('ad-app').hidden = false;
    await loadRequests();          // stats use the request list
    await Promise.all([loadStats(), loadActivity()]);
  }

  async function loadRequests() {
    const { data, error } = await supabase!.rpc('admin_venue_managers');
    if (error) { $('ad-requests').innerHTML = `<p class="ad-empty">${esc(error.message)}</p>`; return; }
    rows = (data ?? []) as Req[];
    const who = (r: Req) => `<strong>${esc(r.display_name || r.username || 'Member')}</strong>${r.username ? ` <a href="/u/?u=${esc(r.username)}" target="_blank" rel="noopener">@${esc(r.username)}</a>` : ''}${r.email ? ` · <a href="mailto:${esc(r.email)}">${esc(r.email)}</a>` : ''}`;
    const pending = rows.filter((r) => r.status === 'pending');
    $('ad-req-count').textContent = pending.length ? `${pending.length} waiting` : '';
    $('ad-requests').innerHTML = pending.length ? pending.map((r) => `
      <div class="ad-row">
        <div class="ad-row-main">
          <p class="ad-row-title">${esc(vname(r.venue_slug))}</p>
          <p class="ad-row-meta">${who(r)} · asked ${timeAgo(r.created_at)}</p>
          ${r.note ? `<p class="ad-note-text">“${esc(r.note)}”</p>` : ''}
        </div>
        <div class="ad-actions">
          <button type="button" class="btn ad-approve" data-approve="${r.id}">Approve</button>
          <button type="button" class="ad-btn-ghost" data-deny="${r.id}">Deny</button>
        </div>
      </div>`).join('') : '<p class="ad-empty">No requests waiting.</p>';
    const approved = rows.filter((r) => r.status === 'approved');
    $('ad-managers').innerHTML = approved.length ? approved.map((r) => `
      <div class="ad-row">
        <div class="ad-row-main">
          <p class="ad-row-title"><a href="/venues/${esc(r.venue_slug)}/" target="_blank" rel="noopener">${esc(vname(r.venue_slug))}</a></p>
          <p class="ad-row-meta">${who(r)}${r.decided_at ? ` · since ${new Date(r.decided_at).toLocaleDateString()}` : ''}</p>
        </div>
        <div class="ad-actions"><button type="button" class="ad-btn-ghost" data-remove="${r.id}">Remove</button></div>
      </div>`).join('') : '<p class="ad-empty">No venue managers yet.</p>';
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const ap = t.closest<HTMLButtonElement>('[data-approve]'), dn = t.closest<HTMLButtonElement>('[data-deny]'), rm = t.closest<HTMLButtonElement>('[data-remove]');
    if (ap || dn) {
      (ap || dn)!.disabled = true;
      await supabase!.from('venue_managers').update({ status: ap ? 'approved' : 'denied', decided_at: new Date().toISOString() }).eq('id', +(ap?.dataset.approve || dn!.dataset.deny!));
      await loadRequests(); await loadStats();
    } else if (rm) {
      if (!confirmRemove(rm)) return;
      await supabase!.from('venue_managers').delete().eq('id', +rm.dataset.remove!);
      await loadRequests(); await loadStats();
    }
  });
  // two-tap remove instead of a browser confirm() dialog
  function confirmRemove(btn: HTMLButtonElement) {
    if (btn.dataset.armed) return true;
    btn.dataset.armed = '1'; btn.textContent = 'Tap again to remove';
    setTimeout(() => { delete btn.dataset.armed; btn.textContent = 'Remove'; }, 3000);
    return false;
  }

  $('ad-add').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('ad-add-msg');
    const uname = $<HTMLInputElement>('ad-add-user').value.trim().replace(/^@/, '').toLowerCase();
    const venue = $<HTMLSelectElement>('ad-add-venue').value;
    const { data } = await supabase!.rpc('search_profiles', { p_query: uname });
    const match = ((data ?? []) as any[]).find((p) => (p.username || '').toLowerCase() === uname);
    if (!match) { msg.textContent = `No member with the username @${uname}.`; msg.classList.add('bad'); return; }
    const { error } = await supabase!.from('venue_managers').upsert(
      { user_id: match.id, venue_slug: venue, status: 'approved', decided_at: new Date().toISOString() }, { onConflict: 'user_id,venue_slug' });
    msg.classList.toggle('bad', !!error);
    msg.textContent = error ? error.message : `@${uname} now manages ${vname(venue)}.`;
    if (!error) { (e.target as HTMLFormElement).reset(); await loadRequests(); await loadStats(); }
  });

  $<HTMLSelectElement>('ad-jump').addEventListener('change', (e) => {
    const s = (e.target as HTMLSelectElement).value;
    $<HTMLAnchorElement>('ad-jump-go').href = s ? `/manage/?v=${encodeURIComponent(s)}` : '/manage/';
  });

  async function count(table: string, filter?: (q: any) => any) {
    let q = supabase!.from(table).select('*', { count: 'exact', head: true });
    if (filter) q = filter(q);
    const { count: n } = await q;
    return n ?? 0;
  }
  async function loadStats() {
    const pending = rows.filter((r) => r.status === 'pending').length;
    const managers = new Set(rows.filter((r) => r.status === 'approved').map((r) => r.venue_slug)).size;
    const [site, events, posts, photos] = await Promise.all([
      supabase!.rpc('admin_stats'),
      count('venue_events', (q) => q.gte('event_date', todayCT())), count('venue_posts'), count('venue_photos'),
    ]);
    const s = ((site.data ?? []) as any[])[0] ?? {};
    const members = s.members ?? '—', going = s.rsvps ?? '—';
    const tile = (n: number | string, label: string, hot = false) => `<div class="ad-stat${hot ? ' hot' : ''}"><strong>${n}</strong><span>${label}</span></div>`;
    $('ad-stats').innerHTML = [
      tile(pending, 'Requests waiting', pending > 0), tile(managers, 'Venues with an owner'), tile(members, 'Members'),
      tile(events, 'Upcoming venue events'), tile(posts, 'Venue posts'), tile(photos, 'Venue photos'), tile(going, '“I’m going”s'),
    ].join('');
  }

  async function loadActivity() {
    const [p, ph] = await Promise.all([
      supabase!.from('venue_posts').select('*').order('created_at', { ascending: false }).limit(15),
      supabase!.from('venue_photos').select('*').order('created_at', { ascending: false }).limit(24),
    ]);
    const items = [
      ...((p.data ?? []) as any[]).map((x) => ({ ...x, _t: 'post' })),
      ...((ph.data ?? []) as any[]).map((x) => ({ ...x, _t: 'photo' })),
    ].sort((a, b) => b.created_at.localeCompare(a.created_at)).slice(0, 30);
    $('ad-activity').innerHTML = items.length ? items.map((x) => `
      <div class="ad-act" data-kind="${x._t}" data-id="${x.id}" data-path="${esc(x._t === 'post' ? x.image_path ?? '' : x.storage_path)}">
        ${x._t === 'photo' || x.image_url ? `<img src="${esc(x._t === 'photo' ? x.url : x.image_url)}" alt="" loading="lazy" />` : ''}
        <div class="ad-act-main">
          <p class="ad-row-meta"><a href="/venues/${esc(x.venue_slug)}/" target="_blank" rel="noopener">${esc(vname(x.venue_slug))}</a> · ${x._t === 'post' ? 'post' : x.kind === 'party' ? 'party pic' : x.kind === 'menu' ? 'menu photo' : 'gallery photo'} · ${timeAgo(x.created_at)}${x.taken_on ? ` · night of ${fmtDate(x.taken_on)}` : ''}</p>
          ${x._t === 'post' ? `<p class="ad-act-body">${esc(x.body)}</p>` : x.caption ? `<p class="ad-act-body">${esc(x.caption)}</p>` : ''}
        </div>
        <button type="button" class="ad-btn-ghost" data-takedown>Remove</button>
      </div>`).join('') : '<p class="ad-empty">Nothing yet. Once owners start posting, it shows here.</p>';
  }
  $('ad-activity').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-takedown]');
    if (!b || !confirmRemove(b)) return;
    const row = b.closest<HTMLElement>('.ad-act')!;
    await supabase!.from(row.dataset.kind === 'post' ? 'venue_posts' : 'venue_photos').delete().eq('id', +row.dataset.id!);
    await removeVenueFile(row.dataset.path);
    row.remove(); loadStats();
  });

  init();
</script>

<style is:global>
  .ad { max-width: 1000px; }
  .ad-note { padding: 18px 20px; margin: 10px 0 20px; color: var(--ink); }
  .ad-note a { color: var(--button-orange); font-weight: 700; }
  .ad-card { padding: 18px 20px; margin: 0 0 16px; color: var(--ink); }
  .ad-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: 0 0 10px; }
  .ad-head h2 { margin: 0; font-size: 18px; color: var(--ink); text-shadow: none; }
  .ad-sub, .ad-help { font-size: 13px; color: var(--ink-2); margin: 0 0 10px; }
  .ad-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin: 6px 0 18px; }
  .ad-stat { padding: 14px 14px 12px; border-radius: var(--radius-sm); background: var(--card); box-shadow: var(--card-depth, var(--shadow)); color: var(--ink); }
  .ad-stat strong { display: block; font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .ad-stat span { font-size: 12px; font-weight: 700; color: var(--ink-2); }
  .ad-stat.hot { background: var(--btn); color: var(--btn-ink); }
  .ad-stat.hot span { color: var(--btn-ink); opacity: .9; }
  .ad-list { display: flex; flex-direction: column; }
  .ad-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .ad-row:last-child { border-bottom: 0; }
  .ad-row-main { flex: 1; min-width: 220px; }
  .ad-row-title { margin: 0; font-size: 16px; font-weight: 800; }
  .ad-row-title a { color: var(--ink); text-decoration: none; }
  .ad-row-meta { margin: 2px 0 0; font-size: 13px; color: var(--ink-2); }
  .ad-row-meta a, .ad-act a { color: var(--button-orange); font-weight: 700; text-decoration: none; }
  .ad-note-text { margin: 6px 0 0; font-size: 14px; color: var(--ink); font-style: italic; }
  .ad-actions { display: flex; gap: 8px; }
  .ad-btn-ghost { background: none; border: 1px solid var(--chip-border); border-radius: 999px; padding: 8px 14px; font: 700 13px var(--font); color: var(--ink-2); cursor: pointer; }
  .ad-btn-ghost:hover { border-color: #C2410C; color: #C2410C; }
  .ad-empty { margin: 4px 0; font-size: 14px; color: var(--ink-3); }
  .ad-add { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
  .ad-label { margin: 0 0 6px; font-size: 12px; font-weight: 800; color: var(--ink-2); }
  .ad-add-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .ad-add-row input, .ad-add-row select { flex: 1; min-width: 180px; font: 500 15px var(--font); color: var(--ink); background: rgba(255,255,255,.9); border: 1px solid var(--field-border); border-radius: 10px; padding: 9px 11px; }
  .ad-msg { margin: 6px 0 0; font-size: 13px; font-weight: 700; color: #1F9D55; }
  .ad-msg.bad { color: #C2410C; }
  .ad-activity { display: flex; flex-direction: column; }
  .ad-act { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .ad-act:last-child { border-bottom: 0; }
  .ad-act img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; flex: none; }
  .ad-act-main { flex: 1; min-width: 0; }
  .ad-act-body { margin: 3px 0 0; font-size: 14px; white-space: pre-wrap; }
</style>
