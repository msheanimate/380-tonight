---
import Base from '../layouts/Base.astro';
import VenueCard from '../components/VenueCard.astro';
import { venues, districts, sideOf } from '../lib/data';
import venuePhotosRaw from '../data/venue-photos.json';

const PLACES_KEY = 'AIzaSyAfgZvvM4cJxLg9vhi0xPkZSTn6OIWLi8M';
const venuePhotos = venuePhotosRaw as Record<string, string[]>;
function firstPhoto(slug: string): string | undefined {
  const refs = venuePhotos[slug];
  if (!refs || refs.length === 0) return undefined;
  return `https://places.googleapis.com/v1/${refs[0]}/media?maxWidthPx=800&key=${PLACES_KEY}`;
}

const drinkTypes = new Set(['bar', 'brewery', 'music-venue']);
const list = venues.filter((v) => drinkTypes.has(v.type) || v.tags.includes('cocktails'));
const withHH = list.filter((v) => v.happy_hour);
const chips = ['patio', 'live-music', 'trivia', 'karaoke', 'late-night', 'cocktails', 'dive', 'sports-bar', 'game-day'];
---
<Base title="Drink" current="Drink">
  <p class="kicker">Drink</p>
  <h1>Every bar, taproom and brewery worth knowing</h1>
  <p class="lede">{list.length} spots across both cities. Filter by what you're after; toggle IC / CR up top.</p>

  <section class="hh" id="happy-hour" data-live-deals data-venues={JSON.stringify(list.map((v) => ({ slug: v.slug, name: v.name, side: sideOf(v.city), windows: v.happy_hours ?? [] })))}>
    <p class="kicker">Happy Hour Finder</p>
    <h3>Where's happy hour right now?</h3>
    <p>Published happy hours logged so far: <strong id="hh-count">{withHH.length}</strong> of {list.length}. Collecting these venue by venue is the first data job; until the count is real, the "cocktails" and "dive" chips below are the cheapest routes.</p>
    <div id="hh-list">
      {withHH.map((v) => (
        <div class="hh-result" data-slug={v.slug} data-side={sideOf(v.city)}><a href={`/venues/${v.slug}/`}>{v.name}</a><span class="when">{v.happy_hour}</span>
          <button type="button" class="card-like-btn" data-slug={v.slug} aria-pressed="false" aria-label={`Like ${v.name}`}><span class="like-icon" aria-hidden="true">♡</span></button></div>
      ))}
    </div>
  </section>

  <div class="filters" data-districts={JSON.stringify(districts.map((d) => ({ slug: d.slug, name: d.name, city: d.city })))}>
    <input type="search" id="q" placeholder="Search bars…" aria-label="Search" />
    <div class="dd-picker" id="district-picker">
      <input type="text" id="district" aria-label="Neighborhood" autocomplete="off" placeholder="All neighborhoods" />
      <button type="button" class="dd-clear" id="district-clear" hidden aria-label="Clear neighborhood filter">&times;</button>
      <div class="hs-dropdown" id="district-dropdown" hidden></div>
    </div>
  </div>
  <div class="chips" id="chips">
    {chips.map((c) => <button class="chip" type="button" data-tag={c} aria-pressed="false">{c.replace('-', ' ')}</button>)}
  </div>

  <div id="list">
    {list.map((v) => <VenueCard venue={{ ...v, photo: firstPhoto(v.slug) }} />)}
  </div>
  <p class="empty hidden" id="empty">Nothing matches. Loosen a filter.</p>

  <script>
    import { createDropdownPicker } from '../lib/dropdown';

    interface DistrictRef { slug: string; name: string; city: string }

    const q = document.getElementById('q') as HTMLInputElement;
    const filtersEl = document.querySelector('.filters') as HTMLElement | null;
    const districtOptions: DistrictRef[] = JSON.parse(filtersEl?.dataset.districts || '[]');
    const districtPickerRoot = document.getElementById('district-picker') as HTMLElement | null;
    const district = document.getElementById('district') as HTMLInputElement;
    const districtClear = document.getElementById('district-clear') as HTMLButtonElement | null;
    const districtDropdown = document.getElementById('district-dropdown') as HTMLElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#chips .chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#list .card'));
    const empty = document.getElementById('empty')!;
    const active = new Set<string>();

    function run() {
      const side = document.documentElement.dataset.side || 'all';
      const text = q.value.trim().toLowerCase();
      const districtValue = districtPicker?.getValue() || '';
      let shown = 0;
      for (const c of cards) {
        const tags = (c.dataset.tags || '').split(' ');
        const ok =
          (side === 'all' || c.dataset.side === side) &&
          (!text || (c.dataset.name || '').includes(text) || c.textContent!.toLowerCase().includes(text)) &&
          (!districtValue || c.dataset.district === districtValue) &&
          [...active].every((t) => tags.includes(t));
        c.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      empty.classList.toggle('hidden', shown > 0);
    }

    const districtPicker = (districtPickerRoot && district && districtDropdown)
      ? createDropdownPicker({
          root: districtPickerRoot,
          input: district,
          dropdown: districtDropdown,
          clearBtn: districtClear,
          options: [
            { value: '', label: 'All neighborhoods' },
            ...districtOptions.map((d) => ({ value: d.slug, label: d.name, meta: d.city })),
          ],
          showAllWhenEmpty: true,
          maxResults: districtOptions.length + 1,
          onChange: () => run(),
        })
      : null;

    q.addEventListener('input', run);
    chips.forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.tag!;
      active.has(t) ? active.delete(t) : active.add(t);
      b.setAttribute('aria-pressed', String(active.has(t)));
      run();
    }));
    document.addEventListener('sidechange', run);
    run();
  </script>

  <script>
    // Owners edit their happy hours at /manage/. Those saves are live in
    // Supabase, so lay them over the happy hours baked into this page: the
    // finder list, the count and each bar's card all switch to the owner's
    // version without waiting for a rebuild.
    import { onLiveDeals, happyOnNow, esc, type HappyWindow, type LiveDeal } from '../lib/venue-portal';
    import { nowInZone } from '../lib/time';
    import { paintLikeButtons } from '../lib/likes';

    type Ref = { slug: string; name: string; side: string; windows: HappyWindow[] };
    const section = document.getElementById('happy-hour')!;
    const listEl = document.getElementById('hh-list')!;
    const refs: Ref[] = JSON.parse(section.dataset.venues || '[]');
    const bySlug = new Map(refs.map((r) => [r.slug, r]));

    function row(slug: string) {
      let el = listEl.querySelector<HTMLElement>(`.hh-result[data-slug="${slug}"]`);
      if (!el) {
        const r = bySlug.get(slug)!;
        el = document.createElement('div');
        el.className = 'hh-result';
        el.dataset.slug = slug;
        el.dataset.side = r.side;
        el.innerHTML = `<a href="/venues/${esc(slug)}/">${esc(r.name)}</a><span class="when"></span>
          <button type="button" class="card-like-btn" data-slug="${esc(slug)}" aria-pressed="false" aria-label="Like ${esc(r.name)}"><span class="like-icon" aria-hidden="true">♡</span></button>`;
        listEl.appendChild(el);
        paintLikeButtons(el);
      }
      return el;
    }

    function markOnNow() {
      const { dow, minutes } = nowInZone();
      listEl.querySelectorAll<HTMLElement>('.hh-result').forEach((el) => {
        const r = bySlug.get(el.dataset.slug || '');
        const on = !!r && happyOnNow(r.windows, dow, minutes);
        el.classList.toggle('on-now', on);
        const a = el.querySelector('a')!;
        a.querySelector('.hh-on')?.remove();
        if (on) a.insertAdjacentHTML('beforeend', ' <span class="hh-on">On now</span>');
      });
      // bars that are pouring right now go to the top
      [...listEl.querySelectorAll<HTMLElement>('.hh-result.on-now')].reverse().forEach((el) => listEl.prepend(el));
    }

    function sideFilter() {
      const side = document.documentElement.dataset.side || 'all';
      listEl.querySelectorAll<HTMLElement>('.hh-result').forEach((el) => {
        el.hidden = side !== 'all' && el.dataset.side !== side;
      });
    }

    // (Each bar's card below is updated by Base.astro from the same data.)
    function applyOwnerHours(deals: Record<string, LiveDeal>) {
      for (const [slug, d] of Object.entries(deals)) {
        const r = bySlug.get(slug);
        if (!r || d.happy_hours === null) continue; // not a drinking spot, or never saved happy hours
        r.windows = d.happy_hours;
        if (!d.summary) { listEl.querySelector(`.hh-result[data-slug="${slug}"]`)?.remove(); continue; }
        const el = row(slug);
        el.querySelector('.when')!.textContent = d.summary;
        el.classList.add('from-venue');
        if (!el.querySelector('.hh-src')) el.insertAdjacentHTML('beforeend', '<span class="hh-src">Updated by the venue</span>');
      }
      document.getElementById('hh-count')!.textContent = String(listEl.querySelectorAll('.hh-result').length);
      markOnNow();
      sideFilter();
    }

    markOnNow();
    sideFilter();
    document.addEventListener('sidechange', sideFilter);
    onLiveDeals(applyOwnerHours);
    setInterval(markOnNow, 60_000);
  </script>

  <style is:global>
    /* built by the happy-hour script, so these can't be scoped */
    #hh-list .hh-result[hidden] { display: none; }
    #hh-list .hh-on {
      display: inline-block; vertical-align: 2px; margin-left: 6px; padding: 2px 8px; border-radius: 999px;
      background: var(--btn); color: var(--btn-ink); font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
    }
    #hh-list .hh-src { font-size: 12px; color: var(--ink-3); font-weight: 600; }
    #hh-list .hh-result { position: relative; padding-right: 44px; }
    #hh-list .card-like-btn {
      top: 50%; right: 0; transform: translateY(-40%); width: 32px; height: 32px;
      background: var(--chip-bg); border-color: var(--chip-border); color: var(--ink);
      -webkit-backdrop-filter: none; backdrop-filter: none;
    }
    #hh-list .card-like-btn:hover { transform: translateY(-40%) scale(1.08); }
    #hh-list .card-like-btn.liked { background: var(--btn); border-color: var(--btn); color: var(--btn-ink); }
  </style>
  <style>
    .filters .dd-picker { position: relative; flex: 1 1 180px; min-width: 0; }
    .filters .dd-picker input {
      width: 100%; box-sizing: border-box; background: var(--card); color: var(--ink);
      border: 1px solid var(--line); box-shadow: var(--shadow); border-radius: 999px;
      padding: 11px 34px 11px 16px; font-size: 15px; font-family: inherit; cursor: pointer;
    }
    .filters .dd-picker input::placeholder { color: var(--ink); opacity: 0.65; }
    .filters .dd-picker input:focus { outline: 2px solid var(--green); outline-offset: 1px; }
    .filters .dd-picker .hs-dropdown { max-height: 260px; overflow-y: auto; min-width: 240px; }
    .dd-clear {
      all: unset; position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;
      border-radius: 50%; font-size: 15px; line-height: 1; color: var(--ink-3); cursor: pointer;
    }
    .dd-clear[hidden] { display: none; }
    .dd-clear:hover { background: rgba(0,0,0,0.08); color: var(--ink); }
  </style>
</Base>
