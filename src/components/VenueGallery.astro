---
/**
 * VenueGallery — sliding photo gallery for venue pages.
 * Reads from src/data/venue-photos.json (generated by fetch-venue-photos.mjs).
 * Falls back to picsum placeholders if no photos exist for a venue yet.
 */
import venuePhotos from '../data/venue-photos.json';

const PLACES_KEY = 'AIzaSyAfgZvvM4cJxLg9vhi0xPkZSTn6OIWLi8M';

interface Props {
  slug: string;
  name: string;
  photos?: string[]; // override with manual URLs if needed
}
const { slug, name, photos } = Astro.props;

// Build image URLs: manual override > Google Places refs > placeholders
const photoData = venuePhotos as Record<string, string[]>;
const refs = photoData[slug] ?? [];

const imgs: string[] = photos?.length
  ? photos
  : refs.length
  ? refs.map(name => `https://places.googleapis.com/v1/${name}/media?maxWidthPx=900&key=${PLACES_KEY}`)
  : Array.from({ length: 4 }, (_, i) => `https://picsum.photos/seed/${slug}-${i + 1}/900/500`);
---

<div class="vg" id="vg" aria-label={`Photos of ${name}`}>
  <div class="vg-track" id="vg-track">
    {imgs.map((src, i) => (
      <div class="vg-slide" data-index={String(i)}>
        <img src={src} alt={i === 0 ? name : `${name} photo ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>

  {imgs.length > 1 && (
    <>
      <button class="vg-btn vg-prev" id="vg-prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button class="vg-btn vg-next" id="vg-next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="vg-dots" id="vg-dots">
        {imgs.map((_, i) => (
          <button class="vg-dot" data-index={String(i)} aria-label={`Photo ${i + 1}`} />
        ))}
      </div>
      <div class="vg-counter" id="vg-counter">1 / {imgs.length}</div>
    </>
  )}
</div>

<style>
  .vg {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius, 12px);
    margin-bottom: 1.5rem;
    background: #111;
    width: calc(100% + 32px);
    margin-left: -16px;
    margin-right: -16px;
    height: 260px;
    border-radius: 0;
  }

  @media (min-width: 480px) { .vg { height: 340px; } }
  @media (min-width: 720px) { .vg { height: 440px; } }

  .vg::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 5em 3em 180px rgba(0,0,0,1);
    pointer-events: none;
    z-index: 5;
  }

  .vg-track {
    display: flex;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .vg-slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .vg-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vg-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 0.15s;
  }
  .vg-btn:hover { background: rgba(0,0,0,0.7); }
  .vg-btn svg { width: 20px; height: 20px; display: block; }
  .vg-prev { left: 0.65rem; }
  .vg-next { right: 0.65rem; }

  @media (max-width: 480px) { .vg-btn { display: none; } }

  .vg-dots {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 4px;
    padding: 0 4px;
    z-index: 10;
  }

  .vg-dot {
    flex: 1;
    height: 4px;
    border-radius: 0;
    border: none;
    padding: 0;
    background: rgba(255,255,255,0.3);
    cursor: pointer;
    transition: background 0.2s;
  }

  .vg-dot.active {
    background: #f97316;
  }

  .vg-counter {
    position: absolute;
    top: 0.65rem;
    right: 0.75rem;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    z-index: 10;
    letter-spacing: 0.03em;
  }
</style>

<script>
  const track   = document.getElementById('vg-track') as HTMLElement;
  const prev    = document.getElementById('vg-prev');
  const next    = document.getElementById('vg-next');
  const dotsEl  = document.getElementById('vg-dots');
  const counter = document.getElementById('vg-counter');

  const slides = Array.from(track?.querySelectorAll<HTMLElement>('.vg-slide') ?? []);
  const dots   = Array.from(dotsEl?.querySelectorAll<HTMLButtonElement>('.vg-dot') ?? []);
  const total  = slides.length;
  let cur = 0;

  function goTo(n: number) {
    cur = (n + total) % total;
    if (track) track.style.transform = `translateX(-${cur * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === cur));
    if (counter) counter.textContent = `${cur + 1} / ${total}`;
  }

  prev?.addEventListener('click', () => goTo(cur - 1));
  next?.addEventListener('click', () => goTo(cur + 1));
  dots.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.index))));

  let tx = 0;
  const vg = document.getElementById('vg');

  // Touch swipe
  vg?.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
  vg?.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 40) goTo(cur + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // Mouse drag
  let mx = 0, dragging = false;
  vg?.addEventListener('mousedown', e => { mx = e.clientX; dragging = true; e.preventDefault(); });
  window.addEventListener('mouseup', e => {
    if (!dragging) return;
    dragging = false;
    const dx = e.clientX - mx;
    if (Math.abs(dx) > 40) goTo(cur + (dx < 0 ? 1 : -1));
  });

  goTo(0);
</script>
