---
import Base from '../layouts/Base.astro';
import VenueCard from '../components/VenueCard.astro';
import EventCard from '../components/EventCard.astro';
import HeroSlider from '../components/HeroSlider.astro';
import HawkeyeBar from '../components/HawkeyeBar.astro';
import { venues, upcomingEvents, fmtDate, sideOf } from '../lib/data';
import venuePhotosRaw from '../data/venue-photos.json';
import { logoFor, gradientFor } from '../lib/art';

const today = new Date();
const { dated, weekly } = upcomingEvents(today);
// Central-Time "today", same convention as the events page and search.
const isoToday = today.toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });
// Anything happening today (single-day, or a multi-day run that includes today)
// gets its own slot up top and leads the hero slider.
const todayEvents = dated.filter((e) => e.date <= isoToday && (e.end_date ?? e.date) >= isoToday);
const next = dated.filter((e) => !todayEvents.includes(e)).slice(0, 4);

const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const dow = today.getDay();
const tonightWeekly = weekly.filter((e) => e.weekday === weekdayNames[dow]);
const dateLine = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

// Google Places photo helper (refs stored in venue-photos.json, populated by fetch-venue-photos.mjs)
const PLACES_KEY = 'AIzaSyAfgZvvM4cJxLg9vhi0xPkZSTn6OIWLi8M';
const venuePhotos = venuePhotosRaw as Record<string, string[]>;
function firstPhoto(slug: string): string | undefined {
  const refs = venuePhotos[slug];
  if (!refs || refs.length === 0) return undefined;
  return `https://places.googleapis.com/v1/${refs[0]}/media?maxWidthPx=800&key=${PLACES_KEY}`;
}

// Tonight's picks: editor-chosen slugs per side. Swap these weekly.
const picksIC = ['gabes', 'coa-cantina', 'big-grove-iowa-city', 'studio-13', 'vue-rooftop'];
const picksCR = ['csps-hall', 'parlor-city-pub', 'quarter-barrel-arcade-brewery', 'goldfinch-tap-eatery', 'lion-bridge-brewing'];
const pick = (slugs: string[]) => slugs.map((s) => venues.find((v) => v.slug === s)).filter(Boolean);
const lateIC = venues.filter((v) => sideOf(v.city) === 'ic' && v.tags.includes('late-night')).slice(0, 4);
const lateCR = venues.filter((v) => sideOf(v.city) === 'cr' && v.tags.includes('late-night')).slice(0, 4);

// Slider: interleave IC and CR picks so toggle-switches feel smooth.
const sliderSlugs = [picksIC[0], picksCR[0], picksIC[1], picksCR[1], picksIC[2], picksCR[2]];
const sliderVenues = sliderSlugs
  .map((s) => venues.find((v) => v.slug === s))
  .filter(Boolean)
  .map((v) => ({ ...v!, photo: firstPhoto(v!.slug) }));

// Today's events go first in the slider. Photo comes from the venue's Google
// Places photos, or -- for places that aren't listed venues (the Ped Mall) --
// from a venue-photos.json entry keyed by the event's venue_slug.
const CAT_LABEL: Record<string, string> = { festival: 'Festival', music: 'Live music', 'game-day': 'Game day', nightlife: 'Nightlife', arts: 'Arts' };
const eventSlides = todayEvents.map((e) => {
  const ven = venues.find((v) => v.slug === e.venue_slug);
  return {
    slug: e.venue_slug,
    name: e.title,
    blurb: e.blurb,
    type: ven?.type ?? 'other',
    city: e.city,
    district: ven?.district ?? '',
    photo: e.image ?? firstPhoto(e.venue_slug),
    eyebrow: `${CAT_LABEL[e.category] ?? 'Event'} · Today · ${e.time}`,
    href: ven ? `/venues/${ven.slug}/` : (e.source ?? '/events/'),
    cta: ven ? 'Visit →' : 'Details →',
  };
});
const sliderSlides = [...eventSlides, ...sliderVenues];

// Specials & happy hours strip: every venue with timed happy-hour windows or a
// daily specials board. The browser works out what's on (or coming) today.
const hhVenues = venues
  .filter((v: any) => (Array.isArray(v.happy_hours) && v.happy_hours.length) || (Array.isArray(v.specials) && v.specials.length))
  .map((v: any) => ({
    slug: v.slug, name: v.name, city: v.city, side: sideOf(v.city),
    address: (v.address || '').split(',')[0],
    tags: (v.tags || []).filter((t: string) => t !== 'happy-hour').slice(0, 3),
    photo: firstPhoto(v.slug) ?? null,
    logo: logoFor(v.website),
    windows: v.happy_hours ?? [],
    specials: v.specials ?? [],
    specialsWindow: v.specials_window ?? null,
  }));
// Everyone else, in brief: if an owner adds happy hours or specials from
// /manage/, the browser can build their card without a rebuild.
const hhSlugs = new Set(hhVenues.map((v) => v.slug));
const hhOthers = venues
  .filter((v: any) => !hhSlugs.has(v.slug))
  .map((v: any) => [v.slug, v.name, v.city, sideOf(v.city), (v.address || '').split(',')[0], (v.tags || []).filter((t: string) => t !== 'happy-hour').slice(0, 3), logoFor(v.website) ?? null]);
---
<Base title="Tonight" current="Tonight">
  <section class="hero">
    <p class="date">{dateLine}</p>
    <h1>What's on tonight, both ends of I-380</h1>
    <p class="lede">Iowa City and Cedar Rapids, 30 minutes apart, one guide. Picks refresh every Thursday.</p>
  </section>

  <HeroSlider slides={sliderSlides as any} />

  {todayEvents.length > 0 && (
    <section class="today-section">
      <h2><span class="badge today-badge">Today</span> Happening today <a class="more" href="/events/">All events →</a></h2>
      {todayEvents.map((e) => <EventCard event={e} />)}
    </section>
  )}

  <HawkeyeBar />

  <section class="hh-now" id="hh-now" data-live-deals data-venues={JSON.stringify(hhVenues)} data-others={JSON.stringify(hhOthers)} hidden>
    <h2><span class="badge today-badge">Now</span> <span id="hh-now-title">Specials &amp; happy hours</span> <span class="hh-now-date" id="hh-now-date"></span> <a class="more" href="/drink/">All bars →</a></h2>
    <div class="row hh-now-row" id="hh-now-row"></div>
  </section>

  <section data-side="ic">
    <h2><span class="badge ic">Iowa City</span> Tonight's picks <a class="more" href="/drink/">All bars →</a></h2>
    <div class="row">{pick(picksIC).map((v) => <VenueCard venue={{ ...v!, photo: firstPhoto(v!.slug) }} pick />)}</div>
  </section>
  <section data-side="cr">
    <h2><span class="badge cr">Cedar Rapids</span> Tonight's picks <a class="more" href="/drink/">All bars →</a></h2>
    <div class="row">{pick(picksCR).map((v) => <VenueCard venue={{ ...v!, photo: firstPhoto(v!.slug) }} pick />)}</div>
  </section>

  {tonightWeekly.length > 0 && (
    <section>
      <h2>Every {weekdayNames[dow]}</h2>
      {tonightWeekly.map((e) => <EventCard event={e} />)}
    </section>
  )}

  <section>
    <h2>Coming up <a class="more" href="/events/">All events →</a></h2>
    {next.map((e) => <EventCard event={e} />)}
  </section>

  <section>
    <h2>Still open late</h2>
    <div class="split">
      <div data-side="ic">{lateIC.map((v) => <VenueCard venue={v} media={false} />)}</div>
      <div data-side="cr">{lateCR.map((v) => <VenueCard venue={v} media={false} />)}</div>
    </div>
  </section>

  <div class="signup">
    <p class="kicker">The Weekend</p>
    <strong>Five picks per city, every Thursday. Free.</strong>
    <form action="#" method="post" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Hook up your email tool';">
      <input type="email" placeholder="you@example.com" aria-label="Email" required />
      <button type="submit">Sign up</button>
    </form>
    <p class="verify">Wire this form to Beehiiv or Mailchimp before launch (see README).</p>
  </div>
</Base>

<script>
  import { nowInZone } from '../lib/time';
  import { onLiveDeals } from '../lib/venue-portal';
  import { paintLikeButtons } from '../lib/likes';
  import { gradientFor } from '../lib/art';

  // Preview any moment with ?at=2026-09-28T15:00 (Central) -- handy for
  // checking what the countdown and the happy-hour strip will show later.
  const atParam = new URLSearchParams(location.search).get('at');
  const previewAt = atParam ? Date.parse(atParam.length <= 16 ? atParam + ':00-05:00' : atParam) : NaN;
  const previewNow = () => (Number.isFinite(previewAt) ? previewAt : Date.now());

  /* ── Specials & happy hours (AppyHour-style cards) ─────────────────── */
  type Win = { days: number[]; start: string; end: string; deal?: string; verify?: boolean };
  type Special = { day: number; food?: string[]; drinks?: string[]; event?: string; start?: string; end?: string };
  type HV = {
    slug: string; name: string; city: string; side: string; address: string; tags: string[];
    photo: string | null; logo: string | null; windows: Win[]; specials: Special[];
    specialsWindow: { start: string; end: string } | null;
  };
  type Deal = { price: string | null; item: string; group: string; kind: 'hh' | 'special'; state: 'on' | 'later'; minutes: number; startMin: number; endMin: number; toClose: boolean; verify?: boolean };

  const hhSection = document.getElementById('hh-now');
  const hhRow = document.getElementById('hh-now-row');
  const hhTitle = document.getElementById('hh-now-title');
  const hhDate = document.getElementById('hh-now-date');
  const hhVenues: HV[] = hhSection ? JSON.parse(hhSection.dataset.venues || '[]') : [];
  const SOON_MIN = 60;          // under this, say "starts in 40 min" instead of "starts at 2 PM"
  const CLOSE_MIN = 2 * 60;     // "till close" = 2 AM
  const MAX_DEALS = 3;          // rows per card before "+N more"
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const now = previewNow;

  const toMin = (t: string) => t === 'close' ? CLOSE_MIN : Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const fmtClock = (min: number) => { const h = Math.floor(min / 60) % 24, m = min % 60; return `${h % 12 || 12}${m ? ':' + String(m).padStart(2, '0') : ''} ${h < 12 ? 'AM' : 'PM'}`; };
  const fmtLeft = (min: number) => min >= 60 ? `${Math.floor(min / 60)}h ${String(min % 60).padStart(2, '0')}m` : `${min}m`;
  // "$10 boneless wing baskets" -> ["$10", "Boneless wing baskets"]; "2-for-1 wells" -> [null, "2-for-1 wells"]
  const splitPrice = (text: string): [string | null, string] => {
    const m = /^\$\s?(\d+(?:\.\d{2})?)\s+(?:off\s+)?(.+)$/i.exec(text.trim());
    if (!m) return [null, text.trim()];
    const isOff = /^\$\s?[\d.]+\s+off/i.test(text);
    const item = m[2].charAt(0).toUpperCase() + m[2].slice(1);
    return isOff ? [`$${m[1]} off`, item] : [`$${m[1]}`, item];
  };

  // Where a [start,end] window on a given weekday stands relative to now
  // (minutes since midnight today). A window ending at "close" (2 AM) runs
  // past midnight, so yesterday's window can still be on at 1 AM.
  type Status = { state: 'on' | 'later'; minutes: number; startMin: number; endMin: number; toClose: boolean };
  function status(days: number[], startT: string, endT: string, dow: number, nowMin: number): Status | null {
    const start = toMin(startT);
    let end = toMin(endT);
    if (end <= start) end += 24 * 60;
    const yesterday = (dow + 6) % 7;
    const candidates: Array<[number, number]> = [];
    if (days.includes(dow)) candidates.push([start, end]);
    if (days.includes(yesterday) && end > 24 * 60) candidates.push([start - 24 * 60, end - 24 * 60]);
    for (const [s, e] of candidates) {
      const toClose = endT === 'close';
      if (nowMin >= s && nowMin < e) return { state: 'on', minutes: e - nowMin, startMin: s, endMin: e, toClose };
      if (nowMin < s) return { state: 'later', minutes: s - nowMin, startMin: s, endMin: e, toClose };
    }
    return null;
  }

  function dealsFor(v: HV, dow: number, nowMin: number): Deal[] {
    const deals: Deal[] = [];
    for (const w of v.windows) {
      const st = status(w.days, w.start, w.end, dow, nowMin);
      if (!st) continue;
      const group = `Happy hour ${fmtClock(toMin(w.start))}–${w.end === 'close' ? 'close' : fmtClock(toMin(w.end))}`;
      const items = w.deal ? w.deal.split(/\s*[,|\n]\s*/).filter(Boolean) : ['Happy hour'];
      for (const it of items) { const [price, item] = splitPrice(it); deals.push({ price, item, group, kind: 'hh', ...st, verify: w.verify }); }
    }
    const sp = v.specials.find((x) => x.day === dow);
    if (sp) {
      const startT = sp.start ?? v.specialsWindow?.start ?? '11:00';
      const endT = sp.end ?? v.specialsWindow?.end ?? 'close';
      const st = status([dow], startT, endT, dow, nowMin);
      if (st) {
        const group = `${DAYS[dow]} specials`;
        for (const it of [...(sp.food ?? []), ...(sp.drinks ?? [])].flatMap((x) => x.split(/\s*\|\s*/)).filter(Boolean)) { const [price, item] = splitPrice(it); deals.push({ price, item, group, kind: 'special', ...st }); }
        if (sp.event) deals.push({ price: null, item: sp.event, group: `${DAYS[dow]} event`, kind: 'special', ...st });
      }
    }
    // On-now first (a running happy hour ahead of all-day specials), then by
    // start time; within a group keep the bar's order.
    return deals.sort((a, b) => {
      if (a.state !== b.state) return a.state === 'on' ? -1 : 1;
      if (a.state === 'on' && a.kind !== b.kind) return a.kind === 'hh' ? -1 : 1;
      return a.startMin - b.startMin;
    });
  }

  // A happy hour that ran earlier today and is already over.
  function happyHourEnded(v: HV, dow: number, nowMin: number) {
    return v.windows.some((w) => {
      if (!w.days.includes(dow)) return false;
      let end = toMin(w.end), start = toMin(w.start);
      if (end <= start) end += 24 * 60;
      return nowMin >= end;
    });
  }

  function logoHtml(v: HV) {
    const initials = v.name.replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
    return `<span class="ah-logo"><span class="ah-logo-initials">${esc(initials)}</span>${v.logo ? `<img src="${esc(v.logo)}" alt="" loading="lazy" onerror="this.remove()" onload="if(this.naturalWidth<=16)this.remove()">` : ''}</span>`;
  }

  function renderHappyHours() {
    if (!hhSection || !hhRow) return;
    const { dow, minutes } = nowInZone(undefined, now());
    if (hhDate) hhDate.textContent = new Date(now()).toLocaleDateString('en-US', { timeZone: 'America/Chicago', weekday: 'long', month: 'long', day: 'numeric' });
    const cards = hhVenues
      .map((v) => ({ v, deals: dealsFor(v, dow, minutes) }))
      .filter((c) => c.deals.length);
    // Happy hours running now lead (most time left first), then bars whose
    // daily specials are on, then what starts later today.
    // Order follows the happy-hour badge: on now, starting later (soonest
    // first), bars with only specials today, then ones whose happy hour ended.
    const key = (c: { deals: Deal[] }) => c.deals[0];
    const order = (c: { v: HV; deals: Deal[] }): [number, number] => {
      const hh = c.deals.find((d) => d.kind === 'hh');
      if (hh) return hh.state === 'on' ? [0, -hh.minutes] : [1, hh.startMin];
      return happyHourEnded(c.v, dow, minutes) ? [3, 0] : [2, 0];
    };
    cards.sort((a, b) => {
      const [ra, sa] = order(a), [rb, sb] = order(b);
      return ra - rb || sa - sb;
    });
    if (!cards.length) { hhSection.hidden = true; return; }
    const onCount = cards.filter((c) => key(c).state === 'on').length;
    if (hhTitle) hhTitle.textContent = onCount ? 'Specials & happy hours right now' : 'Specials & happy hours later today';
    const badge = hhSection.querySelector('.today-badge');
    if (badge) badge.textContent = onCount ? 'Now' : 'Today';

    hhRow.innerHTML = cards.map(({ v, deals }) => {
      const lead = deals[0];
      // Happy hours count down. Daily specials just say how long they run,
      // so a card doesn't look like happy hour is still on after it ended.
      const till = (d: Deal) => (d.toClose ? 'Till close' : `Till ${fmtClock(d.endMin)}`);
      // The badge is always about happy hour: time left, when it starts, or
      // that it's over for today (the specials rows then carry their own times).
      const nextHH = deals.find((d) => d.kind === 'hh');
      const ended = !nextHH && happyHourEnded(v, dow, minutes);
      const timer = nextHH && nextHH.state === 'on'
        ? `<span class="ah-timer on"><b>${fmtLeft(nextHH.minutes)}</b><small>happy hour left</small></span>`
        : nextHH
          ? `<span class="ah-timer"><b>${nextHH.minutes <= SOON_MIN ? 'in ' + nextHH.minutes + 'm' : fmtClock(nextHH.startMin)}</b><small>happy hour starts</small></span>`
          : ended
            ? `<span class="ah-timer ah-timer-over"><b>Ended</b><small>happy hour</small></span>`
            : `<span class="ah-timer"><b>${lead.state === 'on' ? till(lead) : fmtClock(lead.startMin)}</b><small>today's specials</small></span>`;
      // A row only gets its own timer when it's on a different clock than the
      // card's header pill (e.g. a happy hour ending at 6 next to all-day specials).
      const badgeDeal = nextHH ?? (ended ? null : lead);
      const sameClock = (d: Deal) => !!badgeDeal && d.state === badgeDeal.state && d.kind === badgeDeal.kind && d.minutes === badgeDeal.minutes;
      const rows = deals.slice(0, MAX_DEALS).map((d) => `
        <li class="ah-deal${d.state === 'on' ? '' : ' later'}">
          ${d.price ? `<b class="ah-price">${esc(d.price)}</b>` : `<b class="ah-price ah-price-none">★</b>`}
          <span class="ah-deal-body"><span class="ah-item">${esc(d.item)}</span><small class="ah-group">${esc(d.group)}${d.verify ? ' · unconfirmed' : ''}</small></span>
          ${sameClock(d) ? '' : `<span class="ah-deal-time">${d.state === 'on' ? (d.kind === 'hh' ? fmtLeft(d.minutes) + '<small>remaining</small>' : till(d)) : (d.minutes <= SOON_MIN ? 'in ' + d.minutes + 'm' : fmtClock(d.startMin)) + '<small>starts</small>'}</span>`}
        </li>`).join('');
      const more = deals.length > MAX_DEALS ? `<li class="ah-more">+${deals.length - MAX_DEALS} more</li>` : '';
      return `<a class="ah-card" href="/venues/${esc(v.slug)}/" data-side="${esc(v.side)}">
        <div class="ah-photo" style="${v.photo ? `background-image:url('${esc(v.photo)}')` : `background:${gradientFor(v.slug)}`}">
          ${logoHtml(v)}
          ${timer}
          <button type="button" class="card-like-btn" data-slug="${esc(v.slug)}" aria-pressed="false" aria-label="Like ${esc(v.name)}"><span class="like-icon" aria-hidden="true">♡</span></button>
        </div>
        <div class="ah-body">
          <strong class="ah-name">${esc(v.name)}</strong>
          <span class="ah-addr"><span class="badge ${esc(v.side)}">${esc(v.city)}</span>${esc(v.address)}</span>
          ${v.tags.length ? `<span class="ah-tags">${v.tags.map((t) => `<span class="chip">${esc(t.replace(/-/g, ' '))}</span>`).join('')}</span>` : ''}
          <ul class="ah-deals">${rows}${more}</ul>
        </div>
      </a>`;
    }).join('');
    const side = document.documentElement.dataset.side || 'all';
    hhRow.querySelectorAll<HTMLElement>('[data-side]').forEach((el) => el.classList.toggle('hidden', side !== 'all' && el.dataset.side !== side));
    hhSection.hidden = false;
    paintLikeButtons(hhRow);
  }
  renderHappyHours();
  setInterval(renderHappyHours, 60 * 1000);
  document.addEventListener('sidechange', renderHappyHours);

  // Owners' saves from /manage/ win over what was built into the page.
  onLiveDeals((deals) => {
    if (!hhSection) return;
    const others: [string, string, string, string, string, string[], string | null][] = JSON.parse(hhSection.dataset.others || '[]');
    for (const [slug, d] of Object.entries(deals)) {
      let v = hhVenues.find((x) => x.slug === slug);
      if (!v) {
        const o = others.find((x) => x[0] === slug);
        if (!o) continue;
        v = { slug, name: o[1], city: o[2], side: o[3], address: o[4], tags: o[5], photo: null, logo: o[6], windows: [], specials: [], specialsWindow: null };
        hhVenues.push(v);
      }
      if (d.happy_hours !== null) v.windows = d.happy_hours;
      if (d.specials !== null) v.specials = d.specials;
    }
    renderHappyHours();
    // Bars added this way weren't built with a photo; look theirs up.
    if (hhVenues.some((v) => !v.photo)) {
      fetch('/venue-covers.json').then((r) => r.json()).then((covers: Record<string, string>) => {
        let changed = false;
        for (const v of hhVenues) if (!v.photo && covers[v.slug]) { v.photo = covers[v.slug]; changed = true; }
        if (changed) renderHappyHours();
      }).catch(() => {});
    }
  });
</script>
