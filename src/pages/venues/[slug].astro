---
import Base from '../../layouts/Base.astro';
import VenueGallery from '../../components/VenueGallery.astro';
import VenuePhotoGrid from '../../components/VenuePhotoGrid.astro';
import VenueCalendar from '../../components/VenueCalendar.astro';
import VenueLive from '../../components/VenueLive.astro';
import { venues, districtBySlug, TYPE_LABEL, events } from '../../lib/data';
import { iconSvg } from '../../lib/art';
import { showKey } from '../../lib/show-key';

export function getStaticPaths() {
  return venues.map((v) => ({ params: { slug: v.slug }, props: { venue: v } }));
}
const { venue: v } = Astro.props as { venue: (typeof venues)[number] & { photos?: string[], shows?: any[], apis?: string[] } };
const d = districtBySlug(v.district);
const here = events.filter((e) => e.venue_slug === v.slug);
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(v.name + ' ' + v.address)}`;
const site = v.website?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? '';

// Convert events.json entries into the Show format VenueCalendar expects.
// Weekly recurring events are expanded to the next 13 occurrences from today.
interface Show { date: string; time?: string; artist: string; url?: string; }

function parseTime(t?: string): string | undefined {
  if (!t) return undefined;
  const m = t.match(/(\d+)(?::(\d+))?\s*(am|pm|a\.m\.|p\.m\.)/i);
  if (!m) return undefined;
  let h = parseInt(m[1], 10);
  const min = m[2] ? parseInt(m[2], 10) : 0;
  const isPm = /p/i.test(m[3]);
  if (isPm && h !== 12) h += 12;
  if (!isPm && h === 12) h = 0;
  return `${String(h).padStart(2, '0')}:${String(min).padStart(2, '0')}`;
}

const WD: Record<string, number> = { Sun:0, Mon:1, Tue:2, Wed:3, Thu:4, Fri:5, Sat:6 };

function eventsToShows(evs: typeof here): Show[] {
  const shows: Show[] = [];
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  for (const e of evs) {
    if (e.date === 'weekly') {
      const wd = WD[e.weekday as string];
      if (wd === undefined) continue;
      // Find first upcoming occurrence
      const start = new Date(today);
      const daysUntil = (wd - start.getDay() + 7) % 7;
      start.setDate(start.getDate() + daysUntil);
      for (let i = 0; i < 13; i++) {
        shows.push({
          date: start.toISOString().slice(0, 10),
          time: parseTime(e.time),
          artist: e.title,
          url: e.source ?? undefined,
        });
        start.setDate(start.getDate() + 7);
      }
    } else {
      shows.push({
        date: e.date,
        time: parseTime(e.time),
        artist: e.title,
        url: e.source ?? undefined,
      });
    }
  }
  return shows;
}

const venueShows: Show[] = [...(v.shows ?? []), ...eventsToShows(here)];
const showCalendar = v.type === 'music-venue' || v.type === 'theater' || v.type === 'arena'
  || v.tags?.includes('live-music') || venueShows.length > 0;

// Compact "upcoming shows" quadrant on the dashboard -- next 5, soonest first.
const WEEKDAY_SHORT = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
function fmtWeekday(dateStr: string): string {
  return WEEKDAY_SHORT[new Date(`${dateStr}T00:00:00`).getDay()];
}
function fmtDayOfMonth(dateStr: string): string {
  return String(new Date(`${dateStr}T00:00:00`).getDate());
}
function fmtShowTime(t?: string): string | undefined {
  if (!t) return undefined;
  const [hStr, mStr] = t.split(':');
  let h = parseInt(hStr, 10);
  const ampm = h >= 12 ? 'PM' : 'AM';
  h = h % 12; if (h === 0) h = 12;
  return `${h}:${mStr} ${ampm}`;
}
const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Chicago' }); // matches events.astro's Central-Time "today" convention
const compactShows = venueShows
  .filter((s) => s.date >= todayStr)
  .sort((a, b) => a.date.localeCompare(b.date) || (a.time ?? '').localeCompare(b.time ?? ''))
  .slice(0, 5);

// "Next up" badge -- only surfaced when the very next show is today or tomorrow.
const tomorrowDate = new Date(`${todayStr}T00:00:00`);
tomorrowDate.setDate(tomorrowDate.getDate() + 1);
const tomorrowStr = tomorrowDate.toISOString().slice(0, 10);
const nextShow = compactShows[0];
const nextUpLabel = !nextShow ? null
  : nextShow.date === todayStr ? 'Today'
  : nextShow.date === tomorrowStr ? 'Tomorrow'
  : null;

// Non-calendar venues (most bars/restaurants) show quick facts in that quadrant instead.
// (Hours is omitted here since it's already surfaced in the Type/Hours row above.)
// Daily specials (bars like 2 Dogs that run a different deal each day).
const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
type Special = { day: number; food?: string[]; drinks?: string[]; event?: string };
const specials: Special[] = ((v as any).specials ?? []).slice().sort((a: Special, b: Special) => a.day - b.day);
const todayDow = new Date(todayStr + 'T12:00:00').getDay();
const todaySpecial = specials.find((sp) => sp.day === todayDow);
const todaySpecialLine = todaySpecial
  ? [...(todaySpecial.food ?? []), ...(todaySpecial.drinks ?? [])].join(' · ')
  : null;

// Specials and happy hour always get a row (hidden when empty) so an owner's
// update from /manage/ can fill them in on load; see Base.astro.
type Fact = { label: string; value: string; live?: 'hh' | 'specials' };
const compactFacts = [
  { label: 'Address', value: v.address },
  { label: `Today's specials`, value: todaySpecialLine ?? '', live: 'specials' },
  { label: 'Happy hour', value: v.happy_hour ?? '', live: 'hh' },
  site ? { label: 'Web', value: site } : null,
].filter((f): f is Fact => f !== null);
---
<Base title={v.name} description={v.blurb}>
  <div class="venue-dashboard">
    <div class="vp-cell vp-gallery-cell">
      <VenueGallery slug={v.slug} name={v.name} photos={v.photos} />
    </div>

    <div class="vp-cell vp-info-cell">
      <p class="kicker">{TYPE_LABEL[v.type] ?? v.type} &middot; {d ? <a href={`/neighborhoods/${d.slug}/`}>{d.name}</a> : v.city}</p>
      <h1>{v.name}</h1>
      <div class="vp-meta-row">
        <div class="vp-meta-item">
          <Fragment set:html={iconSvg(v.type, 'width="15" height="15" style="margin-top:2px;flex-shrink:0"')} />
          <div class="vp-meta-text">
            <span class="vp-meta-label">Type</span>
            <span class="vp-meta-value">{TYPE_LABEL[v.type] ?? v.type}</span>
          </div>
        </div>
        <div class="vp-meta-item">
          <Fragment set:html={iconSvg('clock', 'width="15" height="15" style="margin-top:2px;flex-shrink:0"')} />
          <div class="vp-meta-text">
            <span class="vp-meta-label">Hours</span>
            <span class="vp-meta-value" data-live="hours">{v.hours_note ?? 'Varies'}</span>
          </div>
        </div>
      </div>
      <div class="tags">{v.tags.map((t) => <span class="tag">{t.replace('-', ' ')}</span>)}</div>
      <p class="lede" data-live="blurb">{v.blurb}</p>
      <div class="actions">
        <a class="btn" href={maps} rel="noopener">Directions</a>
        {v.website && <a class="btn secondary" href={v.website} rel="noopener">Website</a>}
        {v.menu_url && <a class="btn secondary" href={v.menu_url} rel="noopener" target="_blank">Menu</a>}
        {v.doordash_url && <a class="btn secondary" href={v.doordash_url} rel="noopener" target="_blank">Order on DoorDash</a>}
        <button type="button" class="btn secondary like-btn" id="like-btn" data-slug={v.slug} aria-pressed="false" hidden>
          <span class="like-icon" id="like-icon" aria-hidden="true">♡</span> <span id="like-count-label">Like</span>
        </button>
      </div>
    </div>

    <div class="vp-cell vp-shows-cell">
      {showCalendar ? (
        <>
          <div class="vp-shows-head">
            <div class="vp-shows-head-left">
              <span class="vp-shows-title">Upcoming shows</span>
              {venueShows.length > 0 && <span class="vp-shows-count">{venueShows.length}</span>}
            </div>
            {nextUpLabel && (
              <div class="vp-next-up">
                <span class="vp-next-up-label">Next up</span>
                <span class="vp-next-up-value">{nextUpLabel}</span>
              </div>
            )}
          </div>
          {compactShows.length > 0 ? (
            <div class="vp-shows-list">
              {compactShows.map((s) => (
                <div class="vp-show-row">
                  <div class="vp-show-date">
                    <span class="vp-show-wd">{fmtWeekday(s.date)}</span>
                    <span class="vp-show-dom">{fmtDayOfMonth(s.date)}</span>
                  </div>
                  <div class="vp-show-info">
                    <span class="vp-show-name">{s.artist}</span>
                    {fmtShowTime(s.time) && <span class="vp-show-time">{fmtShowTime(s.time)}</span>}
                    <span class="going-friends" data-show-key={showKey(v.slug, s.date, s.artist)} hidden></span>
                  </div>
                  <button type="button" class="going-btn" data-show-key={showKey(v.slug, s.date, s.artist)} data-slug={v.slug} data-date={s.date} data-artist={s.artist} aria-pressed="false">
                    <span class="going-icon" aria-hidden="true">✓</span>
                    <span class="going-label">I'm going</span>
                    <span class="going-count" hidden></span>
                  </button>
                </div>
              ))}
            </div>
          ) : (
            <p class="vp-shows-empty">Nothing confirmed yet -- check back closer to the date.</p>
          )}
          <a href="#venue-calendar" class="vp-shows-more">See full calendar &darr;</a>
        </>
      ) : (
        <>
          <div class="vp-shows-head">
            <span class="vp-shows-title">Good to know</span>
          </div>
          <div class="vp-facts-list">
            {compactFacts.map((f) => (
              <div class="vp-fact-row" hidden={!f.value}
                data-hh-slug={f.live === 'hh' ? v.slug : undefined}
                data-specials-slug={f.live === 'specials' ? v.slug : undefined}>
                <span class="vp-fact-label">{f.label}</span>
                <span class="vp-fact-value hh-text">{f.value}</span>
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="vp-cell vp-comments-cell">
      <section class="venue-comments" id="venue-comments" data-slug={v.slug}>
        <h2>Comments</h2>
        <div id="vc-list" class="vc-list"></div>
        <p id="vc-empty" class="vc-empty" hidden>No comments yet -- be the first.</p>

        <form id="vc-form" class="vc-form" hidden>
          <div class="vc-compose">
            <textarea id="vc-body" maxlength="500" rows="2" placeholder={`Say something about ${v.name}`}></textarea>
            <div class="vc-compose-row">
              <div class="dd-picker" id="vc-tag-picker">
                <input type="text" id="vc-tag-input" autocomplete="off" placeholder="Tag a friend (optional)" />
                <button type="button" class="dd-clear" id="vc-tag-clear" hidden aria-label="Clear tagged friend">&times;</button>
                <div class="hs-dropdown" id="vc-tag-dropdown" hidden></div>
              </div>
              <button type="submit" class="btn secondary vc-submit">Comment</button>
            </div>
          </div>
        </form>
        <p id="vc-login-prompt" class="vc-login-prompt" hidden><a href="/login/">Log in</a> to leave a comment.</p>
        <p id="vc-unconfigured" class="auth-unconfigured" hidden>Accounts aren't connected yet -- check back soon.</p>
      </section>
    </div>
  </div>

  <VenueLive slug={v.slug} name={v.name} />

  {v.verify && <p class="verify">Seeded from <a href={v.source} rel="noopener">a public listing</a> and not yet walked by us. Hours and specials change; check before you go.</p>}

  {specials.length > 0 && (
    <section class="specials-board" data-today={String(todayDow)}>
      <h2>This week's specials <a class="more" href={(v as any).specials_source ?? v.website} rel="noopener" target="_blank">From the bar ↗</a></h2>
      <div class="specials-grid">
        {specials.map((sp) => (
          <div class:list={['specials-day', { today: sp.day === todayDow }]} data-day={String(sp.day)}>
            <div class="specials-day-head">
              <span class="specials-day-name">{DAY_NAMES[sp.day]}</span>
              {sp.day === todayDow && <span class="badge today-badge">Today</span>}
            </div>
            {sp.food?.length ? <ul class="specials-list food">{sp.food.map((f) => <li>{f}</li>)}</ul> : null}
            {sp.drinks?.length ? <ul class="specials-list drinks">{sp.drinks.map((d) => <li>{d}</li>)}</ul> : null}
            {sp.event && <p class="specials-event">{sp.event}</p>}
          </div>
        ))}
      </div>
      {(v as any).specials_note && <p class="specials-note">{(v as any).specials_note}</p>}
    </section>
  )}

  {showCalendar && (
    <div class="facts">
      <div class="fact"><b>Address</b>{v.address}</div>
      {v.hours_note && <div class="fact"><b>Hours</b>{v.hours_note}</div>}
      <div class="fact" data-hh-slug={v.slug} hidden={!v.happy_hour}><b>Happy hour</b><span class="hh-text">{v.happy_hour}</span></div>
      <div class="fact"><b>Web</b>{site}</div>
    </div>
  )}

  {showCalendar && (
    <div id="venue-calendar">
      <VenueCalendar slug={v.slug} name={v.name} shows={venueShows} apis={v.apis} />
    </div>
  )}

  <VenuePhotoGrid slug={v.slug} name={v.name} />

  <p><a href="/drink/">&larr; Drink</a> &middot; <a href="/eat/">Eat</a> &middot; <a href="/neighborhoods/">Neighborhoods</a></p>

  <style>
    .venue-dashboard {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin: 20px 0 28px;
      padding: 20px;
      border-radius: 28px;
      border: 1px solid var(--glass-border);
      box-shadow: var(--shadow-lg);
    }
    /* The glass panel gets its own vivid photo layer here instead of relying
       on backdrop-filter to sample main's background -- main's background is
       deliberately scrimmed very dark for legibility elsewhere on the page,
       so blurring through that scrim just produced flat gray with none of
       the photo's color left. This pseudo paints a bright, only-lightly
       tinted crop of the same photo and blurs THAT, so the panel reads as
       real frosted glass over Kinnick Stadium, not a gray box. */
    .venue-dashboard::before {
      content: '';
      position: absolute;
      inset: -60px;
      /* White wash raised from .30 to .46 (plus a touch of brightness) so the
         panel reads lighter while the blurred photo still shows through. */
      background-image: linear-gradient(rgba(255,255,255,.46), rgba(255,255,255,.46)), var(--photo-url);
      background-size: cover, cover;
      background-position: center, center 30%;
      background-repeat: no-repeat, no-repeat;
      filter: blur(34px) brightness(1.06);
      z-index: 0;
    }
    .venue-dashboard > .vp-cell {
      position: relative;
      z-index: 1;
    }
    @media (min-width: 860px) {
      .venue-dashboard {
        grid-template-columns: 1.6fr 1fr;
        /* min 308px keeps the comp's proportions for normal names, but the
           rows must be allowed to grow: a long venue name wraps the 56px h1
           to three lines and the info cell overflowed a hard 308px row,
           spilling on top of the comments cell below it. */
        grid-template-rows: minmax(308px, auto) minmax(308px, auto);
        padding: 32px;
        border-radius: 36px;
        gap: 20px;
        /* Break out to the comp's own measured 1344px container width --
           the site's normal reading column (var(--max), 1280px) is narrower
           than the comp's 1440px mockup canvas. Centered on the viewport,
           not on .wrap, since it's now wider than .wrap itself; the algebra
           of left:50% + translateX(-50%) centers correctly on the viewport
           regardless of .wrap's own width as long as .wrap is itself
           centered (it is, via margin:0 auto). */
        width: 1344px;
        max-width: calc(100vw - 32px);
        left: 50%;
        transform: translateX(-50%);
      }
    }

    /* This whole dashboard sits on the light glass panel, not the bare photo
       canvas -- pin its headings back to dark ink (global.css styles h1/h2/
       .kicker/.lede for the bare-canvas case everywhere else on the site). */
    .venue-dashboard h1 { color: var(--ink); margin: 0; font-size: 38px; line-height: 1.05; }
    @media (min-width: 860px) { .venue-dashboard h1 { font-size: 56px; } }
    .venue-dashboard .kicker a { text-decoration: none; }
    .venue-dashboard h2 { color: var(--ink); margin: 0 0 12px; }
    .venue-dashboard .kicker { color: var(--green-dark); }
    .venue-dashboard .lede { color: var(--ink-2); margin: 0; font-size: 15px; line-height: 1.55; }
    /* Directions / Website: bright-orange pills with white text, matching
       the signup, Game Day and "See full calendar" buttons. */
    .venue-dashboard .btn, .venue-dashboard .btn.secondary {
      font-size: 13px; background: var(--btn); color: var(--btn-ink);
      box-shadow: 0 4px 12px var(--btn-glow); transition: filter .15s, transform .15s;
    }
    .venue-dashboard .btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
    /* "Comments" should read at the same small, compact weight as "Upcoming
       shows" (comp styles both as 14px/700 labels, not as a full h2). */
    .venue-dashboard .vp-comments-cell h2 { font-size: 14px; font-weight: 700; margin: 0 0 10px; }

    .vp-gallery-cell {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      min-height: 220px;
    }
    .vp-gallery-cell :global(.vg) {
      width: 100%;
      margin: 0;
    }
    @media (min-width: 860px) {
      .vp-gallery-cell { height: 100%; }
      /* Absolutely positioned so the gallery fills whatever height the row
         ends up (it stretches to match a tall info column) without its own
         photo ever driving the row height -- as a normal in-flow item the
         image's natural height would size the track and blow the panel up. */
      .vp-gallery-cell :global(.vg) { position: absolute; inset: 0; height: 100% !important; }
    }

    .vp-info-cell {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 10px;
    }
    .vp-info-cell .tags { margin-top: 0; }
    .vp-info-cell .actions { margin: 6px 0 0; }
    .vp-info-cell .tag {
      text-transform: uppercase; letter-spacing: .04em; font-weight: 700;
      font-size: 10px; padding: 5px 12px;
    }

    .vp-meta-row { display: flex; gap: 26px; flex-wrap: wrap; }
    .vp-meta-item { display: flex; align-items: flex-start; gap: 7px; color: var(--ink-2); }
    .vp-meta-text { display: flex; flex-direction: column; gap: 1px; }
    .vp-meta-label { font-size: 10px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; color: var(--ink-2); }
    .vp-meta-value { font-size: 13px; font-weight: 700; color: var(--ink); }

    .vp-shows-cell, .vp-comments-cell { display: flex; flex-direction: column; }

    .vp-shows-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; flex-shrink: 0; }
    .vp-shows-head-left { display: flex; align-items: center; gap: 9px; min-width: 0; }
    .vp-shows-title { font-size: 14px; font-weight: 700; color: var(--ink); }
    .vp-shows-count {
      width: 22px; height: 22px; border-radius: 999px; border: 1px solid var(--chip-border);
      display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: var(--ink);
      flex-shrink: 0;
    }
    .vp-next-up { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .vp-next-up-label { font-size: 11px; color: var(--ink-2); }
    .vp-next-up-value { font-size: 11px; font-weight: 700; color: var(--btn-ink); background: var(--btn); border-radius: 999px; padding: 3px 10px; }
    .vp-shows-list { display: flex; flex-direction: column; }
    .vp-show-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--chip-border); }
    .vp-show-row:last-child { border-bottom: none; }
    .vp-show-date { width: 42px; text-align: center; flex-shrink: 0; }
    .vp-show-wd { display: block; font-size: 9px; font-weight: 700; letter-spacing: .5px; color: var(--ink-2); }
    .vp-show-dom { display: block; font-size: 15px; font-weight: 800; color: var(--ink); }
    .vp-show-info { display: flex; flex-direction: column; min-width: 0; flex-grow: 1; }
    .vp-show-name { font-size: 13px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .vp-show-time { font-size: 11px; color: var(--ink-2); }
    .vp-show-info .going-friends { margin-top: 3px; }
    .vp-shows-empty { font-size: 13px; color: var(--ink-2); font-style: italic; margin: 0; }
    /* Bright-orange pill button (same orange as the signup / Game Day
       buttons) so it reads as a real action on the blurred-photo glass. */
    .vp-shows-more {
      display: inline-block; align-self: flex-start; width: max-content; font-size: 13px; font-weight: 700; color: var(--btn-ink);
      background: var(--btn); border-radius: 999px; padding: 8px 14px;
      margin-top: 10px; text-decoration: none;
      box-shadow: 0 4px 12px var(--btn-glow);
      transition: filter .15s, transform .15s;
    }
    .vp-shows-more:hover { filter: brightness(1.08); transform: translateY(-1px); }

    .vp-facts-list { display: flex; flex-direction: column; }
    .vp-fact-row { display: flex; flex-direction: column; gap: 1px; padding: 7px 0; border-bottom: 1px solid var(--chip-border); }
    .vp-fact-row:last-child { border-bottom: none; }
    .vp-fact-label { font-size: 10px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; color: var(--ink-2); }
    .vp-fact-value { font-size: 13px; font-weight: 700; color: var(--ink); }

    .vp-comments-cell .venue-comments { margin: 0; }
    .vp-comments-cell .vc-list { max-height: 260px; overflow-y: auto; }

    .like-btn.liked { color: var(--btn-on-light); border-color: var(--btn); }
    .venue-dashboard .vp-info-cell .like-btn {
      width: 38px; height: 38px; padding: 0; gap: 0;
      border-radius: 999px; background: var(--chip-bg); border: 1px solid var(--chip-border);
      box-shadow: none; color: var(--ink); /* stays a neutral chip, not an orange pill */
    }
    .venue-dashboard .vp-info-cell .like-btn:hover { filter: none; transform: none; }
    .venue-dashboard .vp-info-cell .like-btn.liked { color: var(--btn-on-light); }
    .venue-dashboard .vp-info-cell .like-btn .like-icon { font-size: 16px; line-height: 1; }
    .venue-dashboard .vp-info-cell .like-btn #like-count-label {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    .vc-empty { color: var(--ink-2); }
    .vc-empty[hidden] { display: none; }
    .vc-form { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
    .vc-form[hidden] { display: none; }
    .vc-compose {
      display: flex; flex-direction: column; gap: 10px;
      padding: 14px; border-radius: 16px;
      background: var(--chip-bg); border: 1px solid var(--chip-border);
    }
    .vc-compose textarea {
      font-family: inherit; font-size: 15px; padding: 0; border: none;
      background: transparent; color: var(--ink); resize: vertical; outline: none;
    }
    .vc-compose textarea::placeholder { color: #fff; }
    .vc-compose-row { display: flex; align-items: center; gap: 10px; }
    .vc-compose-row .dd-picker { flex: 1; min-width: 0; }
    .vc-submit { flex-shrink: 0; }
    .dd-picker { position: relative; }
    .dd-picker input {
      width: 100%; box-sizing: border-box; font-family: inherit; font-size: 13px;
      padding: 8px 30px 8px 10px; border: 1px solid var(--chip-border); border-radius: 999px;
      background: var(--card); color: var(--ink); cursor: pointer;
    }
    .dd-picker input::placeholder { color: var(--ink-3); }
    .dd-picker input:focus { outline: 2px solid var(--green); outline-offset: 1px; }
    .dd-picker .hs-dropdown { max-height: 260px; overflow-y: auto; }
    .dd-clear {
      all: unset; position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
      border-radius: 50%; font-size: 16px; line-height: 1; color: var(--ink-3); cursor: pointer;
    }
    .dd-clear[hidden] { display: none; }
    .dd-clear:hover { background: rgba(0,0,0,0.06); color: var(--ink); }
    .vc-login-prompt a { color: var(--green-dark); font-weight: 700; text-decoration: none; }
    .vc-login-prompt a:hover { text-decoration: underline; }
    .vc-login-prompt[hidden], .auth-unconfigured[hidden] { display: none; }
    /* ── Weekly specials board ─────────────────────────────────────────── */
    .specials-board { margin: 24px 0 8px; }
    .specials-board h2 { display: flex; align-items: baseline; gap: 12px; }
    .specials-board h2 .more { margin-left: auto; font-size: 13px; }
    .specials-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
    .specials-day {
      display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; border-radius: var(--radius-sm);
      background: var(--card); box-shadow: var(--shadow); color: var(--ink);
      -webkit-backdrop-filter: blur(var(--glass-blur)); backdrop-filter: blur(var(--glass-blur));
    }
    .specials-day.today { outline: 2px solid var(--button-orange); outline-offset: -2px; }
    .specials-day-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
    .specials-day-name { font-weight: 800; font-size: 14px; }
    .specials-list { list-style: none; margin: 0; padding: 0; font-size: 13px; line-height: 1.35; }
    .specials-list li { padding-left: 16px; position: relative; }
    .specials-list li::before { position: absolute; left: 0; top: 0; font-size: 12px; }
    .specials-list.food li::before { content: '🍔'; }
    .specials-list.drinks li::before { content: '🍺'; }
    .specials-event { margin: 2px 0 0; font-size: 12px; font-weight: 700; color: var(--green-dark); }
    .specials-note { margin: 10px 0 0; font-size: 13px; color: var(--ink-on-photo-2); }
  </style>

  <script>
    import { supabase, supabaseConfigured } from '../../lib/supabase';
    import { paintAvatar } from '../../lib/avatar';
    import { createDropdownPicker, type DropdownPickerHandle } from '../../lib/dropdown';

    interface CommentRow {
      id: number; user_id: string; username: string; display_name: string | null;
      avatar_url: string | null; body: string; created_at: string;
      tagged_user_id: string | null; tagged_username: string | null; tagged_display_name: string | null;
    }
    interface FriendOption { id: string; username: string; display_name: string | null }

    function timeAgo(iso: string): string {
      const diff = Date.now() - new Date(iso).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 1) return 'just now';
      if (mins < 60) return `${mins}m ago`;
      const hours = Math.floor(mins / 60);
      if (hours < 24) return `${hours}h ago`;
      const days = Math.floor(hours / 24);
      if (days < 30) return `${days}d ago`;
      return new Date(iso).toLocaleDateString();
    }

    const commentsSection = document.getElementById('venue-comments') as HTMLElement | null;
    const commentSlug = commentsSection?.dataset.slug;
    const vcList = document.getElementById('vc-list');
    const vcEmpty = document.getElementById('vc-empty') as HTMLElement | null;
    const vcForm = document.getElementById('vc-form') as HTMLFormElement | null;
    const vcBody = document.getElementById('vc-body') as HTMLTextAreaElement | null;
    const vcTagPickerRoot = document.getElementById('vc-tag-picker') as HTMLElement | null;
    const vcTagInput = document.getElementById('vc-tag-input') as HTMLInputElement | null;
    const vcTagClear = document.getElementById('vc-tag-clear') as HTMLButtonElement | null;
    const vcTagDropdown = document.getElementById('vc-tag-dropdown') as HTMLElement | null;
    const vcLoginPrompt = document.getElementById('vc-login-prompt') as HTMLElement | null;
    const vcUnconfigured = document.getElementById('vc-unconfigured') as HTMLElement | null;

    if (commentSlug && supabaseConfigured && supabase) {
      let myId: string | undefined;
      let commentRows: CommentRow[] = [];
      let friendPicker: DropdownPickerHandle | null = null;

      function renderComments() {
        if (!vcList) return;
        vcList.innerHTML = '';
        commentRows.forEach((c) => {
          const card = document.createElement('div');
          card.className = 'vc-comment';
          // Avatar links to the commenter's page, same as their name.
          const avatarEl = document.createElement('a');
          avatarEl.className = 'avatar avatar-sm vc-comment-avatar';
          avatarEl.href = `/u/?u=${encodeURIComponent(c.username)}`;
          avatarEl.setAttribute('aria-label', c.display_name || c.username);
          paintAvatar(avatarEl, c.avatar_url, c.display_name, undefined);
          const bodyWrap = document.createElement('div');
          bodyWrap.className = 'vc-comment-body';
          const nameEl = document.createElement('div');
          nameEl.className = 'vc-comment-name';
          const nameLink = document.createElement('a');
          nameLink.href = `/u/?u=${encodeURIComponent(c.username)}`;
          nameLink.textContent = c.display_name || c.username;
          nameEl.appendChild(nameLink);
          if (c.tagged_username) {
            const tagEl = document.createElement('span');
            tagEl.className = 'vc-comment-tag';
            tagEl.append(' → ');
            const tagLink = document.createElement('a');
            tagLink.href = `/u/?u=${encodeURIComponent(c.tagged_username)}`;
            tagLink.textContent = c.tagged_display_name || c.tagged_username;
            tagEl.appendChild(tagLink);
            nameEl.appendChild(tagEl);
          }
          const textEl = document.createElement('p');
          textEl.className = 'vc-comment-text';
          textEl.textContent = c.body;
          const metaEl = document.createElement('div');
          metaEl.className = 'vc-comment-meta';
          const dateEl = document.createElement('span');
          dateEl.className = 'vc-comment-date';
          dateEl.textContent = timeAgo(c.created_at);
          metaEl.appendChild(dateEl);
          if (myId && myId === c.user_id) {
            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'vc-comment-delete';
            delBtn.textContent = 'Delete';
            delBtn.addEventListener('click', async () => {
              delBtn.disabled = true;
              await supabase!.from('comments').delete().eq('id', c.id).eq('user_id', myId);
              commentRows = commentRows.filter((r) => r.id !== c.id);
              renderComments();
            });
            metaEl.appendChild(delBtn);
          }
          bodyWrap.append(nameEl, textEl, metaEl);
          card.append(avatarEl, bodyWrap);
          vcList.appendChild(card);
        });
        if (vcEmpty) vcEmpty.hidden = commentRows.length > 0;
      }

      async function loadComments() {
        const { data } = await supabase!.rpc('venue_comments', { p_venue_slug: commentSlug });
        commentRows = (data as CommentRow[]) || [];
        renderComments();
      }

      vcForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!vcBody || !myId) return;
        const body = vcBody.value.trim();
        if (!body) return;
        const submitBtn = vcForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (submitBtn) submitBtn.disabled = true;
        try {
          const tagged_user_id = friendPicker?.getValue() || null;
          const { error } = await supabase!.from('comments').insert({ user_id: myId, venue_slug: commentSlug, body, tagged_user_id });
          if (!error) {
            vcBody.value = '';
            friendPicker?.setValue('', { silent: true });
            await loadComments();
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });

      (async () => {
        const { data: { session } } = await supabase!.auth.getSession();
        myId = session?.user?.id;
        if (myId) {
          const { data: friends } = await supabase!.rpc('my_friends');
          const friendOptions = ((friends as FriendOption[]) || []).map((f) => (
            { value: f.id, label: f.display_name || f.username, meta: `@${f.username}` }
          ));
          if (vcTagPickerRoot && vcTagInput && vcTagDropdown) {
            friendPicker = createDropdownPicker({
              root: vcTagPickerRoot,
              input: vcTagInput,
              dropdown: vcTagDropdown,
              clearBtn: vcTagClear,
              options: friendOptions,
              showAllWhenEmpty: true,
              noResultsText: 'No friends found',
            });
          }
          vcForm?.removeAttribute('hidden');
        } else {
          vcLoginPrompt?.removeAttribute('hidden');
        }
        await loadComments();
      })();
    } else if (vcUnconfigured) {
      vcUnconfigured.hidden = false;
    }

    const btn = document.getElementById('like-btn') as HTMLButtonElement | null;
    const iconEl = document.getElementById('like-icon');
    const labelEl = document.getElementById('like-count-label');
    const slug = btn?.dataset.slug;

    if (btn && slug && supabaseConfigured && supabase) {
      btn.hidden = false;
      let liked = false;

      async function refresh() {
        const { data } = await supabase!.rpc('venue_like_info', { p_slug: slug });
        const info = Array.isArray(data) ? data[0] : data;
        liked = Boolean(info?.liked_by_me);
        const count = info?.like_count ?? 0;
        btn!.setAttribute('aria-pressed', String(liked));
        btn!.classList.toggle('liked', liked);
        if (iconEl) iconEl.textContent = liked ? '♥' : '♡';
        if (labelEl) labelEl.textContent = count > 0 ? `Liked · ${count}` : 'Like';
      }

      btn.addEventListener('click', async () => {
        const { data: { session } } = await supabase!.auth.getSession();
        if (!session?.user) {
          location.href = '/login/';
          return;
        }
        btn!.disabled = true;
        try {
          if (liked) {
            await supabase!.from('likes').delete().eq('user_id', session.user.id).eq('venue_slug', slug);
          } else {
            await supabase!.from('likes').insert({ user_id: session.user.id, venue_slug: slug });
          }
          await refresh();
        } finally {
          btn!.disabled = false;
        }
      });

      refresh();
    }
  </script>
</Base>
