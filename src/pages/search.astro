---
import Base from '../layouts/Base.astro';
import venuesIC from '../data/venues-iowa-city.json';
import venuesCR from '../data/venues-cedar-rapids.json';

const allVenues = [...venuesIC, ...venuesCR];
const searchable = allVenues.map((v) => ({
  slug: v.slug,
  name: v.name,
  type: v.type,
  city: v.city,
  district: v.district,
  tags: v.tags,
  blurb: v.blurb,
  happy_hour: v.happy_hour ?? null,
  artists: ((v as any).shows ?? []).map((s: any) => s.artist as string),
}));
---
<Base title="Search" current="Search">
  <div class="search-page">
    <p class="kicker">Search</p>
    <h1>Find a bar or restaurant</h1>

    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input
        id="q"
        type="search"
        placeholder="Name, vibe, tag…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        autofocus
        aria-label="Search venues"
      />
      <button id="clear-btn" aria-label="Clear search" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="type-chips" id="type-chips">
      <button class="chip active" data-type="" type="button">All</button>
      <button class="chip" data-type="bar" type="button">Bars</button>
      <button class="chip" data-type="brewery" type="button">Breweries</button>
      <button class="chip" data-type="restaurant" type="button">Restaurants</button>
      <button class="chip" data-type="music-venue" type="button">Music</button>
    </div>

    <p class="result-count" id="result-count" aria-live="polite"></p>

    <div id="results" class="results"></div>
    <p class="empty hidden" id="empty">Nothing matched — try a different word.</p>
    <p class="search-hint" id="hint">Type to search all {allVenues.length} venues across Iowa City and Cedar Rapids.</p>
  </div>
</Base>

<script define:vars={{ searchable }}>
  const input   = document.getElementById('q');
  const clearBtn = document.getElementById('clear-btn');
  const resultsEl = document.getElementById('results');
  const emptyEl   = document.getElementById('empty');
  const hintEl    = document.getElementById('hint');
  const countEl   = document.getElementById('result-count');
  const chips     = Array.from(document.querySelectorAll('#type-chips .chip'));

  let activeType = '';

  function sideOf(city) {
    return ['Iowa City','Coralville','North Liberty'].includes(city) ? 'ic' : 'cr';
  }

  function cityLabel(city) {
    if (['Iowa City','Coralville','North Liberty'].includes(city)) return 'Iowa City';
    if (city === 'Marion') return 'Marion';
    return 'Cedar Rapids';
  }

  function typeLabel(type) {
    const map = { bar:'Bar', brewery:'Brewery', restaurant:'Restaurant',
      'music-venue':'Music Venue', theater:'Theater', cinema:'Cinema',
      arena:'Arena', other:'Venue' };
    return map[type] || 'Venue';
  }

  function renderCard(v, q) {
    const side = sideOf(v.city);
    const tags = v.tags.slice(0, 3).map(t =>
      `<span class="tag">${t.replace('-',' ')}</span>`).join('');
    const hh = v.happy_hour
      ? `<span class="hh-badge">🍺 ${v.happy_hour}</span>` : '';
    const matchedArtist = q && v.artists && v.artists.find(a => a.toLowerCase().includes(q));
    const artistHint = matchedArtist
      ? `<p class="rc-artist-hint">🎵 ${matchedArtist}</p>` : '';
    return `
      <a class="result-card" href="/venues/${v.slug}/" data-side="${side}">
        <div class="rc-left">
          <p class="rc-meta">
            <span class="badge ${side}">${cityLabel(v.city)}</span>
            <span class="rc-type">${typeLabel(v.type)}</span>
          </p>
          <strong class="rc-name">${v.name}</strong>
          <p class="rc-blurb">${v.blurb}</p>
          ${artistHint}
          ${hh}
          <div class="rc-tags">${tags}</div>
        </div>
        <svg class="rc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </a>`;
  }

  function run() {
    const raw  = input.value.trim();
    const q    = raw.toLowerCase();
    const side = document.documentElement.dataset.side || 'all';

    clearBtn.hidden = raw.length === 0;
    hintEl.classList.toggle('hidden', raw.length > 0 || activeType !== '');

    if (!q && !activeType) {
      resultsEl.innerHTML = '';
      emptyEl.classList.add('hidden');
      countEl.textContent = '';
      return;
    }

    const filtered = searchable.filter((v) => {
      const matchSide = side === 'all' || sideOf(v.city) === side;
      const matchType = !activeType || v.type === activeType;
      const matchQ    = !q ||
        v.name.toLowerCase().includes(q) ||
        v.blurb.toLowerCase().includes(q) ||
        v.tags.some(t => t.replace(/-/g, ' ').includes(q)) ||
        v.type.includes(q) ||
        v.city.toLowerCase().includes(q) ||
        v.district.includes(q) ||
        (v.artists && v.artists.some(a => a.toLowerCase().includes(q)));
      return matchSide && matchType && matchQ;
    });

    resultsEl.innerHTML = filtered.map(v => renderCard(v, q)).join('');
    emptyEl.classList.toggle('hidden', filtered.length > 0);
    countEl.textContent = filtered.length > 0
      ? `${filtered.length} result${filtered.length === 1 ? '' : 's'}` : '';
  }

  input.addEventListener('input', run);
  clearBtn.addEventListener('click', () => { input.value = ''; input.focus(); run(); });

  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach(b => b.classList.remove('active'));
    c.classList.add('active');
    activeType = c.dataset.type;
    run();
  }));

  document.addEventListener('sidechange', run);

  // Pre-fill from ?q= URL param
  const urlQ = new URLSearchParams(location.search).get('q') || '';
  if (urlQ) { input.value = urlQ; run(); }
</script>

<style>
  .search-page { padding-bottom: 4rem; }

  .search-box {
    position: relative;
    margin: 1rem 0 0.75rem;
  }

  .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: var(--text-muted, #888);
    pointer-events: none;
  }

  #q {
    width: 100%;
    padding: 0.75rem 2.75rem 0.75rem 2.6rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1.5px solid var(--border, #e5e7eb);
    border-radius: 50px;
    background: var(--surface, #fff);
    color: var(--text, #111);
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
  }

  #q:focus {
    border-color: var(--green, #1fb865);
    box-shadow: 0 0 0 3px rgba(31,184,101,0.15);
  }

  #clear-btn {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: none;
    background: var(--surface-2, #f3f4f6);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--text-muted, #888);
  }

  #clear-btn svg { width: 14px; height: 14px; }
  #clear-btn[hidden] { display: none; }

  .type-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .chip {
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    border: 1.5px solid var(--border, #e5e7eb);
    background: var(--surface, #fff);
    color: var(--text, #111);
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
  }

  .chip.active {
    background: var(--green, #1fb865);
    border-color: var(--green, #1fb865);
    color: #fff;
  }

  .result-count {
    font-size: 0.8rem;
    color: var(--text-muted, #888);
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .result-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    background: var(--surface, #fff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .result-card:hover {
    border-color: var(--green, #1fb865);
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  }

  .rc-left { flex: 1; min-width: 0; }

  .rc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
  }

  .rc-type {
    color: var(--text-muted, #888);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.7rem;
  }

  .rc-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .rc-blurb {
    font-size: 0.82rem;
    color: var(--text-muted, #777);
    margin: 0 0 0.4rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hh-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--green-dark, #0e7c47);
    background: rgba(31,184,101,0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 50px;
    margin-bottom: 0.35rem;
  }

  .rc-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 50px;
    background: var(--surface-2, #f3f4f6);
    color: var(--text-muted, #666);
    text-transform: capitalize;
  }

  .rc-arrow {
    width: 18px;
    height: 18px;
    color: var(--text-muted, #aaa);
    flex-shrink: 0;
  }

  .search-hint {
    color: var(--text-muted, #aaa);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .rc-artist-hint {
    font-size: 0.78rem;
    color: var(--green-dark, #0e7c47);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .empty { color: var(--text-muted, #888); margin-top: 1rem; }
  .hidden { display: none !important; }
</style>
